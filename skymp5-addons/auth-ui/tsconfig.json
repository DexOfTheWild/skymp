{
  "compilerOptions": {
    "target": "es5",
    "module": "es2015",
    "strict": true,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["esnext"],
    "outDir": "dist",
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": [
    "client/**/*.ts",
    "shared/**/*.ts",
    "../../skymp5-addons-api/clientAddonHost.ts"
  ]
}
